{
  "version": 2,
  "builds": [
    {
      "src": "src/app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11",
        "includeFiles": ["static/**", "src/templates/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app/main.py"
    }
  ]
}